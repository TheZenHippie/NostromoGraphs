<Window x:Class="NostromoGraphs.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
        Title="MUTHUR 6000 // NOSTROMO SENSOR TELEMETRY GRAPHS"
        Icon="icon.png"
        Height="580" Width="860"
        MinHeight="320" MinWidth="480"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        SizeChanged="Window_SizeChanged"
        ContextMenuOpening="Window_ContextMenuOpening">

    <Window.ContextMenu>
        <ContextMenu x:Name="MainContextMenu"
                     PreviewMouseMove="MainContextMenu_PreviewMouseMove"
                     PreviewMouseLeftButtonDown="MainContextMenu_PreviewMouseLeftButtonDown"
                     Closed="MainContextMenu_Closed">

            <!-- Displays Selection Submenu -->
            <MenuItem x:Name="DisplaysMenu" Header="Select Telemetry Display..."/>
            <Separator/>

            <!-- Display Duration Controls (10s to 60s) -->
            <MenuItem StaysOpenOnClick="True">
                <MenuItem.Header>
                    <StackPanel Width="220" Margin="0,2">
                        <DockPanel LastChildFill="False">
                            <TextBlock Text="Display Duration (Hold)" FontWeight="SemiBold"/>
                            <TextBlock x:Name="DurationValueText" Text="20.0s" DockPanel.Dock="Right" Foreground="#666666"/>
                        </DockPanel>
                        <Slider x:Name="DurationSlider"
                                Minimum="10.0" Maximum="60.0" Value="20.0"
                                SmallChange="1.0" LargeChange="5.0"
                                Margin="0,6,0,2"
                                PreviewMouseWheel="Slider_PreviewMouseWheel"
                                ValueChanged="DurationSlider_ValueChanged"/>
                    </StackPanel>
                </MenuItem.Header>
            </MenuItem>
            <MenuItem Header="Duration Presets...">
                <MenuItem Header="10 Seconds (Fast Cycle)" Click="DurationPreset_Click" Tag="10.0"/>
                <MenuItem Header="15 Seconds" Click="DurationPreset_Click" Tag="15.0"/>
                <MenuItem Header="20 Seconds (Nostromo Standard)" Click="DurationPreset_Click" Tag="20.0" IsChecked="True"/>
                <MenuItem Header="30 Seconds" Click="DurationPreset_Click" Tag="30.0"/>
                <MenuItem Header="45 Seconds" Click="DurationPreset_Click" Tag="45.0"/>
                <MenuItem Header="60 Seconds (Full Analysis)" Click="DurationPreset_Click" Tag="60.0"/>
            </MenuItem>
            <MenuItem x:Name="AutoCycleMenuItem" Header="Auto-Cycle Displays" IsCheckable="True" IsChecked="True" Click="AutoCycle_Click"/>
            <MenuItem x:Name="ScreenClearGlitchMenuItem" Header="Screen Clear Glitch Transition" IsCheckable="True" IsChecked="True" Click="ScreenClearGlitch_Click"/>
            <Separator/>

            <!-- Playback Controls -->
            <MenuItem x:Name="PauseResumeMenuItem" Header="Pause Auto-Cycle" Click="PauseResume_Click"/>
            <MenuItem Header="Next Display (Forward)" Click="NextDisplay_Click"/>
            <MenuItem Header="Previous Display (Back)" Click="PrevDisplay_Click"/>
            <MenuItem Header="Trigger Screen Clear Glitch" Click="TriggerGlitch_Click"/>
            <Separator/>

            <!-- Display Color Mode (Vintage Monochrome vs Modern Colorized) -->
            <MenuItem x:Name="DisplayColorModeMenuItem" Header="Display Color Mode">
                <MenuItem x:Name="MonochromeModeMenuItem" Header="Vintage Monochrome (Classic Single Phosphor)" IsCheckable="True" IsChecked="True" Click="MonochromeMode_Click"/>
                <MenuItem x:Name="ColorizedModeMenuItem" Header="Modern Multi-Color (Full Accent HUD)" IsCheckable="True" IsChecked="False" Click="ColorizedMode_Click"/>
            </MenuItem>
            <Separator/>

            <!-- Phosphor (Text) Color Palette with Visual Swatches -->
            <MenuItem x:Name="PhosphorColorMenuItem" Header="Phosphor Color">
                <MenuItem Header="Matrix / Nostromo Green" Click="PhosphorColor_Click" Tag="#00FF66" IsChecked="True">
                    <MenuItem.Icon>
                        <Border Width="16" Height="16" CornerRadius="3" Background="#00FF66" BorderBrush="#80FFFFFF" BorderThickness="1"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Solar Amber (Alien Gold)" Click="PhosphorColor_Click" Tag="#FFB000">
                    <MenuItem.Icon>
                        <Border Width="16" Height="16" CornerRadius="3" Background="#FFB000" BorderBrush="#80FFFFFF" BorderThickness="1"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Nostromo Cyan" Click="PhosphorColor_Click" Tag="#00F0FF">
                    <MenuItem.Icon>
                        <Border Width="16" Height="16" CornerRadius="3" Background="#00F0FF" BorderBrush="#80FFFFFF" BorderThickness="1"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Phosphor White" Click="PhosphorColor_Click" Tag="#F0F0F0">
                    <MenuItem.Icon>
                        <Border Width="16" Height="16" CornerRadius="3" Background="#F0F0F0" BorderBrush="#80FFFFFF" BorderThickness="1"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Glitch Red" Click="PhosphorColor_Click" Tag="#FF2244">
                    <MenuItem.Icon>
                        <Border Width="16" Height="16" CornerRadius="3" Background="#FF2244" BorderBrush="#80FFFFFF" BorderThickness="1"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Night City Violet" Click="PhosphorColor_Click" Tag="#A040FF">
                    <MenuItem.Icon>
                        <Border Width="16" Height="16" CornerRadius="3" Background="#A040FF" BorderBrush="#80FFFFFF" BorderThickness="1"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Synthwave Magenta" Click="PhosphorColor_Click" Tag="#FF007F">
                    <MenuItem.Icon>
                        <Border Width="16" Height="16" CornerRadius="3" Background="#FF007F" BorderBrush="#80FFFFFF" BorderThickness="1"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Custom Phosphor Color..." Click="CustomPhosphorColor_Click"/>
            </MenuItem>

            <!-- Background Color Palette with Visual Swatches -->
            <MenuItem x:Name="BackgroundColorMenuItem" Header="Background Color">
                <MenuItem Header="Tinted CRT Dark Green" Click="BackgroundColor_Click" Tag="#08140B" IsChecked="True">
                    <MenuItem.Icon>
                        <Border Width="16" Height="16" CornerRadius="3" Background="#08140B" BorderBrush="#80FFFFFF" BorderThickness="1"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Deep Amber Dark" Click="BackgroundColor_Click" Tag="#140B04">
                    <MenuItem.Icon>
                        <Border Width="16" Height="16" CornerRadius="3" Background="#140B04" BorderBrush="#80FFFFFF" BorderThickness="1"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Pitch Black (Void)" Click="BackgroundColor_Click" Tag="#000000">
                    <MenuItem.Icon>
                        <Border Width="16" Height="16" CornerRadius="3" Background="#000000" BorderBrush="#80FFFFFF" BorderThickness="1"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Dark Charcoal" Click="BackgroundColor_Click" Tag="#0E1116">
                    <MenuItem.Icon>
                        <Border Width="16" Height="16" CornerRadius="3" Background="#0E1116" BorderBrush="#80FFFFFF" BorderThickness="1"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Deep Space Navy" Click="BackgroundColor_Click" Tag="#040812">
                    <MenuItem.Icon>
                        <Border Width="16" Height="16" CornerRadius="3" Background="#040812" BorderBrush="#80FFFFFF" BorderThickness="1"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Custom Background Color..." Click="CustomBackgroundColor_Click"/>
            </MenuItem>
            <Separator/>

            <!-- Visual Effects Suite -->
            <MenuItem x:Name="EffectsMenuItem"
                      Header="Visual Effects Suite"
                      StaysOpenOnClick="True"
                      MouseEnter="EffectsMenuItem_MouseEnter"
                      MouseLeave="EffectsMenuItem_MouseLeave"
                      SubmenuOpened="EffectsMenuItem_SubmenuOpened"
                      SubmenuClosed="EffectsMenuItem_SubmenuClosed">

                <!-- Phosphor Bloom Glow -->
                <MenuItem x:Name="BloomGlowMenuItem"
                          Header="Phosphor Bloom Glow"
                          IsCheckable="True"
                          IsChecked="True"
                          StaysOpenOnClick="True"
                          Click="BloomGlow_Click"/>
                <MenuItem StaysOpenOnClick="True">
                    <MenuItem.Header>
                        <StackPanel Width="200" Margin="0,2">
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="Bloom Intensity" FontWeight="SemiBold"/>
                                <TextBlock x:Name="BloomIntensityValueText" Text="8px" DockPanel.Dock="Right" Foreground="#666666"/>
                            </DockPanel>
                            <Slider x:Name="BloomIntensitySlider"
                                    Minimum="0" Maximum="25" Value="8"
                                    SmallChange="1" LargeChange="3"
                                    TickFrequency="1" IsSnapToTickEnabled="True"
                                    Margin="0,6,0,2"
                                    PreviewMouseWheel="Slider_PreviewMouseWheel"
                                    ValueChanged="BloomIntensitySlider_ValueChanged"/>
                        </StackPanel>
                    </MenuItem.Header>
                </MenuItem>
                <Separator/>

                <!-- Vintage CRT Scanlines -->
                <MenuItem x:Name="CrtScanlinesMenuItem"
                          Header="Vintage CRT Scanlines"
                          IsCheckable="True"
                          IsChecked="False"
                          StaysOpenOnClick="True"
                          Click="CrtScanlines_Click"/>
                <MenuItem StaysOpenOnClick="True">
                    <MenuItem.Header>
                        <StackPanel Width="200" Margin="0,2">
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="Scanline Thickness" FontWeight="SemiBold"/>
                                <TextBlock x:Name="ScanlineThicknessValueText" Text="3px" DockPanel.Dock="Right" Foreground="#666666"/>
                            </DockPanel>
                            <Slider x:Name="ScanlineThicknessSlider"
                                    Minimum="1" Maximum="16" Value="3"
                                    SmallChange="1" LargeChange="2"
                                    TickFrequency="1" IsSnapToTickEnabled="True"
                                    Margin="0,6,0,2"
                                    PreviewMouseWheel="Slider_PreviewMouseWheel"
                                    ValueChanged="ScanlineThicknessSlider_ValueChanged"/>
                        </StackPanel>
                    </MenuItem.Header>
                </MenuItem>
                <Separator/>

                <!-- Monochrome CRT Glitch -->
                <MenuItem x:Name="CrtGlitchMenuItem"
                          Header="Monochrome CRT Glitch"
                          IsCheckable="True"
                          IsChecked="True"
                          StaysOpenOnClick="True"
                          Click="CrtGlitch_Click"/>
                <MenuItem StaysOpenOnClick="True">
                    <MenuItem.Header>
                        <StackPanel Width="200" Margin="0,2">
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="Glitch Intensity" FontWeight="SemiBold"/>
                                <TextBlock x:Name="GlitchIntensityValueText" Text="15%" DockPanel.Dock="Right" Foreground="#666666"/>
                            </DockPanel>
                            <Slider x:Name="GlitchIntensitySlider"
                                    Minimum="0" Maximum="100" Value="15"
                                    SmallChange="1" LargeChange="5"
                                    TickFrequency="1" IsSnapToTickEnabled="True"
                                    Margin="0,6,0,2"
                                    PreviewMouseWheel="Slider_PreviewMouseWheel"
                                    ValueChanged="GlitchIntensitySlider_ValueChanged"/>
                        </StackPanel>
                    </MenuItem.Header>
                </MenuItem>
                <Separator/>

                <!-- CRT Snow Static Noise -->
                <MenuItem x:Name="CrtSnowMenuItem"
                          Header="CRT Snow Static Noise"
                          IsCheckable="True"
                          IsChecked="False"
                          StaysOpenOnClick="True"
                          Click="CrtSnow_Click"/>
                <MenuItem StaysOpenOnClick="True">
                    <MenuItem.Header>
                        <StackPanel Width="200" Margin="0,2">
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="Snow Strength" FontWeight="SemiBold"/>
                                <TextBlock x:Name="SnowAmountValueText" Text="25%" DockPanel.Dock="Right" Foreground="#666666"/>
                            </DockPanel>
                            <Slider x:Name="SnowAmountSlider"
                                    Minimum="0" Maximum="100" Value="25"
                                    SmallChange="1" LargeChange="5"
                                    TickFrequency="1" IsSnapToTickEnabled="True"
                                    Margin="0,6,0,2"
                                    PreviewMouseWheel="Slider_PreviewMouseWheel"
                                    ValueChanged="SnowAmountSlider_ValueChanged"/>
                        </StackPanel>
                    </MenuItem.Header>
                </MenuItem>
            </MenuItem>
            <Separator/>

            <!-- Opacity Sliders -->
            <MenuItem StaysOpenOnClick="True">
                <MenuItem.Header>
                    <StackPanel Width="220" Margin="0,2">
                        <DockPanel LastChildFill="False">
                            <TextBlock Text="Window Glass Opacity" FontWeight="SemiBold"/>
                            <TextBlock x:Name="BackgroundOpacityValueText" Text="90%" DockPanel.Dock="Right" Foreground="#666666"/>
                        </DockPanel>
                        <Slider x:Name="BackgroundOpacitySlider"
                                Minimum="0.30" Maximum="1.0" Value="0.90"
                                SmallChange="0.05" LargeChange="0.1"
                                Margin="0,6,0,2"
                                PreviewMouseWheel="Slider_PreviewMouseWheel"
                                ValueChanged="BackgroundOpacitySlider_ValueChanged"/>
                    </StackPanel>
                </MenuItem.Header>
            </MenuItem>
            <MenuItem StaysOpenOnClick="True">
                <MenuItem.Header>
                    <StackPanel Width="220" Margin="0,2">
                        <DockPanel LastChildFill="False">
                            <TextBlock Text="HUD Brightness" FontWeight="SemiBold"/>
                            <TextBlock x:Name="HudBrightnessValueText" Text="100%" DockPanel.Dock="Right" Foreground="#666666"/>
                        </DockPanel>
                        <Slider x:Name="HudBrightnessSlider"
                                Minimum="0.20" Maximum="1.0" Value="1.0"
                                SmallChange="0.05" LargeChange="0.1"
                                Margin="0,6,0,2"
                                PreviewMouseWheel="Slider_PreviewMouseWheel"
                                ValueChanged="HudBrightnessSlider_ValueChanged"/>
                    </StackPanel>
                </MenuItem.Header>
            </MenuItem>
            <Separator/>

            <!-- Window Options -->
            <MenuItem x:Name="AlwaysOnTopMenuItem" Header="Always on Top" IsCheckable="True" IsChecked="False" Click="AlwaysOnTop_Click"/>
            <MenuItem x:Name="ShadowMenuItem" Header="Window Shadow" IsCheckable="True" IsChecked="True" Click="Shadow_Click"/>
            <MenuItem Header="Reset Window Size (860x580)" Click="ResetSize_Click"/>
            <Separator/>
            <MenuItem Header="Close Nostromo Graphs" Click="CloseWidget_Click"/>
            <MenuItem Header="Exit All" Click="ExitAll_Click"/>
        </ContextMenu>
    </Window.ContextMenu>

    <Grid Background="#01000000">
        <!-- LAYER 0: CRT Glass Panel Background & Drop Shadow -->
        <Border x:Name="WindowBackgroundBorder"
                Margin="14"
                CornerRadius="8"
                BorderThickness="1.5"
                BorderBrush="#4000FF66"
                Background="#E608140B"
                Opacity="0.90">
            <Border.Effect>
                <DropShadowEffect x:Name="WindowDropShadow"
                                  BlurRadius="20"
                                  ShadowDepth="4"
                                  Direction="315"
                                  Color="Black"
                                  Opacity="0.40"
                                  RenderingBias="Performance"/>
            </Border.Effect>
        </Border>

        <!-- LAYER 1: Terminal Content Layout -->
        <Grid x:Name="TerminalContentGrid" Margin="14" Opacity="1.0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Retro Header Bar -->
                <RowDefinition Height="*"/>    <!-- Hardware-Accelerated SkiaSharp Canvas -->
                <RowDefinition Height="Auto"/> <!-- Telemetry Status Footer -->
            </Grid.RowDefinitions>

            <!-- Draggable Retro Header Bar -->
            <Border x:Name="HeaderBarBorder"
                    Grid.Row="0"
                    Background="#15000000"
                    BorderThickness="0,0,0,1"
                    BorderBrush="#2500FF66"
                    CornerRadius="7,7,0,0"
                    Padding="10,6"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <!-- Left: System Identity Badge -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Border x:Name="SystemBadgeBorder"
                                Background="Transparent"
                                BorderBrush="#6000FF66"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="6,2">
                            <TextBlock x:Name="SystemBadgeText"
                                       Text="[ MUTHUR 6000 // SENSORS ]"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="#00FF66"/>
                        </Border>
                    </StackPanel>

                    <!-- Center: Active Graph Title Badge -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border x:Name="HeaderBadgeBorder"
                                Background="Transparent"
                                BorderBrush="#6000FF66"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="8,2">
                            <TextBlock x:Name="HeaderStatusText"
                                       Text="[ INITIALIZING TELEMETRY ]"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="#00FF66"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>

                    <!-- Right-side Quick Action Controls -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <!-- Duration Cycle Badge Button -->
                        <Button x:Name="DurationButton"
                                Style="{x:Null}"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="0"
                                Margin="0,0,6,0"
                                Cursor="Hand"
                                ToolTip="Click to cycle display hold duration"
                                Click="DurationBadge_Click">
                            <Border x:Name="DurationBadgeBorder"
                                    Background="Transparent"
                                    BorderBrush="#5000FF66"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    Padding="5,2">
                                <TextBlock x:Name="DurationBadgeText"
                                           Text="[ 20s CYCLE ]"
                                           FontSize="9.5"
                                           FontWeight="Bold"
                                           Foreground="#00FF66"/>
                            </Border>
                        </Button>

                        <!-- Prev Button -->
                        <Button x:Name="PrevButton"
                                Content="PREV"
                                ToolTip="Previous telemetry display"
                                Style="{x:Null}"
                                Background="Transparent"
                                Foreground="#80FFFFFF"
                                BorderThickness="0"
                                Padding="6,2"
                                FontSize="10"
                                FontWeight="SemiBold"
                                Cursor="Hand"
                                Click="PrevDisplay_Click"/>

                        <!-- Pause / Resume Button -->
                        <Button x:Name="PauseButton"
                                Content="PAUSE"
                                ToolTip="Pause/Resume auto-cycle"
                                Style="{x:Null}"
                                Background="Transparent"
                                Foreground="#80FFFFFF"
                                BorderThickness="0"
                                Padding="6,2"
                                FontSize="10"
                                FontWeight="SemiBold"
                                Cursor="Hand"
                                Click="PauseResume_Click"/>

                        <!-- Next Button -->
                        <Button x:Name="NextButton"
                                Content="NEXT"
                                ToolTip="Next telemetry display"
                                Style="{x:Null}"
                                Background="Transparent"
                                Foreground="#80FFFFFF"
                                BorderThickness="0"
                                Padding="6,2"
                                FontSize="10"
                                FontWeight="SemiBold"
                                Cursor="Hand"
                                Click="NextDisplay_Click"/>

                        <!-- Clear / Glitch Button -->
                        <Button x:Name="ClearButton"
                                Content="CLR"
                                ToolTip="Trigger screen clear glitch effect"
                                Style="{x:Null}"
                                Background="Transparent"
                                Foreground="#80FFFFFF"
                                BorderThickness="0"
                                Padding="6,2"
                                FontSize="10"
                                FontWeight="SemiBold"
                                Cursor="Hand"
                                Click="TriggerGlitch_Click"/>

                        <!-- Close Button -->
                        <Button x:Name="CloseButton"
                                Content="✕"
                                ToolTip="Close Nostromo Graphs"
                                Style="{x:Null}"
                                Background="Transparent"
                                Foreground="#80FFFFFF"
                                BorderThickness="0"
                                Padding="6,2"
                                FontSize="11"
                                FontWeight="Bold"
                                Cursor="Hand"
                                Click="CloseWidget_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main SkiaSharp Canvas with Phosphor Bloom Glow -->
            <Grid Grid.Row="1" x:Name="CanvasContainerGrid">
                <skia:SKElement x:Name="SkiaCanvasElement"
                                PaintSurface="SkiaCanvasElement_PaintSurface"/>
                <Grid.Effect>
                    <DropShadowEffect x:Name="PhosphorBloomEffect"
                                      BlurRadius="8"
                                      ShadowDepth="0"
                                      Color="#00FF66"
                                      Opacity="0.85"
                                      RenderingBias="Performance"/>
                </Grid.Effect>
            </Grid>

            <!-- Telemetry Footer Bar -->
            <Border x:Name="FooterBarBorder"
                    Grid.Row="2"
                    Background="#15000000"
                    BorderThickness="0,1,0,0"
                    BorderBrush="#2500FF66"
                    CornerRadius="0,0,7,7"
                    Padding="10,4">
                <DockPanel LastChildFill="False">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                        <TextBlock x:Name="ActiveFeedText"
                                   Text="FEED: DISPLAY 01/14 - ENVIRONMENTAL GASSES"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="#00FF66"
                                   Margin="0,0,12,0"/>
                        <TextBlock x:Name="StatusFeedText"
                                   Text="STATUS: CONTINUOUS SENSOR FEED"
                                   FontSize="9.5"
                                   Foreground="#70FFFFFF"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="HoldStatusText"
                                   Text="HOLD: 20.0s / 20.0s"
                                   FontSize="9.5"
                                   Foreground="#60FFFFFF"
                                   Margin="0,0,10,0"/>
                        <TextBlock x:Name="FpsStatusText"
                                   Text="60 FPS // GPU SYNC"
                                   FontSize="9.5"
                                   Foreground="#50FFFFFF"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Jitter Transform for Glitch FX -->
            <Grid.RenderTransform>
                <TranslateTransform x:Name="ContentJitterTransform" X="0" Y="0"/>
            </Grid.RenderTransform>
        </Grid>

        <!-- LAYER 2: CRT Overlays (Scanlines, Snow Static Noise, Monochrome Glitch) -->
        <Grid x:Name="CrtOverlayGrid" Margin="14" IsHitTestVisible="False">
            <!-- CRT Snow Static Noise Overlay -->
            <Image x:Name="CrtSnowOverlay"
                   Stretch="Fill"
                   Visibility="Collapsed"
                   Opacity="0.0"
                   IsHitTestVisible="False"
                   RenderOptions.BitmapScalingMode="NearestNeighbor"/>

            <!-- Vintage CRT Scanlines Overlay -->
            <Rectangle x:Name="CrtScanlinesOverlay"
                       Visibility="Collapsed"
                       Opacity="0.80"
                       IsHitTestVisible="False">
                <Rectangle.Fill>
                    <DrawingBrush x:Name="CrtDrawingBrush" TileMode="Tile" Viewport="0,0,1,6" ViewportUnits="Absolute">
                        <DrawingBrush.Drawing>
                            <DrawingGroup>
                                <GeometryDrawing Brush="#00000000">
                                    <GeometryDrawing.Geometry>
                                        <RectangleGeometry Rect="0,0,1,6"/>
                                    </GeometryDrawing.Geometry>
                                </GeometryDrawing>
                                <GeometryDrawing Brush="#E0000000">
                                    <GeometryDrawing.Geometry>
                                        <RectangleGeometry Rect="0,0,1,3"/>
                                    </GeometryDrawing.Geometry>
                                </GeometryDrawing>
                            </DrawingGroup>
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- CRT Monochrome Glitch Canvas -->
            <Canvas x:Name="CrtGlitchCanvas"
                    Visibility="Collapsed"
                    IsHitTestVisible="False"
                    ClipToBounds="True"/>
        </Grid>

        <!-- LAYER 3: Resize Grip -->
        <ResizeGrip HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,16,16"
                    Opacity="0.4"
                    Cursor="SizeNWSE"/>
    </Grid>
</Window>

